<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ParaBankSuite"
       parallel="tests"
       thread-count="2">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>


    <test name="ParaBankTests">

        <classes>

            <class name="tests.LoginTest"/>
            <class name="tests.AccountOverviewTest"/>
            <class name="tests.TransferFundsTest"/>
            <class name="tests.TransactionSearchTest"/>
            <class name="tests.FormValidationTest"/>

        </classes>

    </test>

</suite>